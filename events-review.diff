+import GrecaBand from "../greca";
+import placesIndex from "../../public/data/places-index.json";
+import SuggestEventForm from "./suggest-event-form";
+
+// /sugerir-evento — UNLISTED submission page. Linked from no public page,
+// navigation or sitemap; excluded from indexing via robots metadata below.
+// Share the URL directly (whatsapp, flyers, word of mouth).
+
+export const metadata = {
+  title: "Sugerir un evento / Suggest an event",
+  description:
+    "Envía un evento para el directorio de Felipe Carrillo Puerto. / Submit an event for the Felipe Carrillo Puerto directory.",
+  robots: { index: false, follow: false },
+};
+
+export default function SugerirEvento() {
+  return (
+    <main style={{ maxWidth: "46rem", margin: "0 auto", padding: "0 1rem 4rem", lineHeight: 1.6 }}>
+      <GrecaBand />
+      <h1 style={{ fontFamily: "var(--font-heading)", fontSize: "1.7rem", margin: "1rem 0 0.25rem" }}>
+        Sugerir un evento{" "}
+        <span style={{ fontSize: "1rem", fontWeight: 400 }}>— send us your event / envía tu evento</span>
+      </h1>
+      <p style={{ color: "var(--charcoal-soft)" }}>
+        Cuéntanos sobre tu evento en Felipe Carrillo Puerto o las comunidades de la Zona Maya. Cada
+        propuesta se revisa antes de publicarse: los eventos aparecen solo después de la revisión. / Tell
+        us about your event in Felipe Carrillo Puerto or the Zona Maya communities. Every suggestion is
+        reviewed before publication: events appear only after review.
+      </p>
+      <SuggestEventForm places={placesIndex} />
+    </main>
+  );
+}
diff --git a/app/sugerir-evento/suggest-event-form.js b/app/sugerir-evento/suggest-event-form.js
new file mode 100644
index 0000000..2bcf2ce
--- /dev/null
+++ b/app/sugerir-evento/suggest-event-form.js
@@ -0,0 +1,263 @@
+"use client";
+
+import { useState } from "react";
+import { CATEGORIES } from "../place-index.mjs";
+
+// Submission form for /sugerir-evento. POSTs to the relay configured via
+// NEXT_PUBLIC_EVENT_FORM_ENDPOINT (inlined at build time). When the variable
+// is unset the form never crashes: the submit button is replaced by a
+// graceful mailto fallback.
+
+const FORM_ENDPOINT = process.env.NEXT_PUBLIC_EVENT_FORM_ENDPOINT;
+const CONTACT_EMAIL = "eventos@fcpqroo.mx";
+
+const field = {
+  display: "block",
+  width: "100%",
+  boxSizing: "border-box",
+  marginTop: "0.25rem",
+  padding: "0.55rem 0.7rem",
+  border: "1px solid var(--sand-line)",
+  borderRadius: "8px",
+  background: "#fff",
+  color: "var(--obsidian)",
+  font: "inherit",
+};
+
+const label = { display: "block", fontWeight: 600, fontSize: "0.92rem", marginTop: "0.9rem" };
+const hint = { fontWeight: 400, fontSize: "0.82rem", color: "var(--charcoal-soft)" };
+
+const notice = {
+  background: "var(--cream)",
+  border: "1px solid var(--sand-line)",
+  borderRadius: "10px",
+  padding: "0.9rem 1rem",
+  marginTop: "1.2rem",
+};
+
+const submitButton = {
+  marginTop: "1.2rem",
+  padding: "0.65rem 1.3rem",
+  border: "none",
+  borderRadius: "8px",
+  background: "var(--jungle)",
+  color: "#fff",
+  fontWeight: 600,
+  font: "inherit",
+  cursor: "pointer",
+};
+
+const initial = { name: "", start: "", end: "", venue: "", category: "", cost: "", description: "", contact: "" };
+
+export default function SuggestEventForm({ places }) {
+  const [form, setForm] = useState(initial);
+  const [submitting, setSubmitting] = useState(false);
+  const [submitted, setSubmitted] = useState(false);
+  const [failed, setFailed] = useState(false);
+
+  const venueOptions = (places ?? [])
+    .map((place) => {
+      const es = place.name?.es ?? "";
+      const en = place.name?.en;
+      return en && en !== es ? `${es} / ${en}` : es;
+    })
+    .filter(Boolean);
+
+  function update(key) {
+    return (event) => setForm((current) => ({ ...current, [key]: event.target.value }));
+  }
+
+  async function handleSubmit(event) {
+    event.preventDefault();
+    if (!FORM_ENDPOINT || submitting) return;
+    setSubmitting(true);
+    setFailed(false);
+    try {
+      const body = new URLSearchParams({
+        "form-name": "event-suggestion",
+        ...form,
+      });
+      const response = await fetch(FORM_ENDPOINT, {
+        method: "POST",
+        headers: { "Content-Type": "application/x-www-form-urlencoded" },
+        body,
+      });
+      if (!response.ok) throw new Error(`Form relay responded ${response.status}`);
+      setSubmitted(true);
+    } catch (cause) {
+      console.warn("Event suggestion failed:", cause);
+      setFailed(true);
+    } finally {
+      setSubmitting(false);
+    }
+  }
+
+  const mailto = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(
+    "Sugerencia de evento / Event suggestion"
+  )}&body=${encodeURIComponent(
+    [
+      `Evento / Event: ${form.name}`,
+      `Inicio / Start: ${form.start}`,
+      `Fin / End: ${form.end || "—"}`,
+      `Lugar / Venue: ${form.venue}`,
+      `Categoría / Category: ${form.category}`,
+      `Costo / Cost: ${form.cost || "—"}`,
+      "",
+      form.description,
+      "",
+      `Contacto / Contact: ${form.contact}`,
+    ].join("\n")
+  )}`;
+
+  if (submitted) {
+    return (
+      <div style={notice} role="status">
+        <p style={{ margin: 0, fontWeight: 700 }}>
+          ¡Gracias! / Thank you!
+        </p>
+        <p style={{ margin: "0.4rem 0 0" }}>
+          Recibimos tu propuesta. Tu evento aparecerá en el directorio solo después de la revisión. /
+          We received your suggestion. Your event will appear in the directory only after review.
+        </p>
+      </div>
+    );
+  }
+
+  return (
+    <form onSubmit={handleSubmit} style={{ marginTop: "0.6rem" }}>
+      <label style={label}>
+        Nombre del evento / Event name *
+        <input
+          style={field}
+          name="name"
+          type="text"
+          required
+          autoComplete="off"
+          value={form.name}
+          onChange={update("name")}
+        />
+      </label>
+
+      <label style={label}>
+        Fecha y hora de inicio / Start date and time *
+        <input
+          style={field}
+          name="start"
+          type="datetime-local"
+          required
+          value={form.start}
+          onChange={update("start")}
+        />
+      </label>
+
+      <label style={label}>
+        Fecha y hora de fin (opcional) / End date and time (optional)
+        <input
+          style={field}
+          name="end"
+          type="datetime-local"
+          value={form.end}
+          onChange={update("end")}
+        />
+      </label>
+
+      <label style={label}>
+        Lugar / Venue *
+        <span style={hint}>
+          {" "}
+          — ¿está en el directorio? Escríbelo y aparecerá en la lista. / Is it in the directory?
+          Start typing and it will show up in the list.
+        </span>
+        <input
+          style={field}
+          name="venue"
+          type="text"
+          required
+          list="directory-venues"
+          autoComplete="off"
+          value={form.venue}
+          onChange={update("venue")}
+        />
+        <datalist id="directory-venues">
+          {venueOptions.map((name) => (
+            <option key={name} value={name} />
+          ))}
+        </datalist>
+      </label>
+
+      <label style={label}>
+        Categoría / Category *
+        <select style={field} name="category" required value={form.category} onChange={update("category")}>
+          <option value="" disabled>
+            —
+          </option>
+          {CATEGORIES.filter(({ id }) => id !== "all").map(({ id, label: categoryLabel }) => (
+            <option key={id} value={id}>
+              {categoryLabel.es} / {categoryLabel.en}
+            </option>
+          ))}
+        </select>
+      </label>
+
+      <label style={label}>
+        Costo (opcional) / Cost (optional)
+        <input
+          style={field}
+          name="cost"
+          type="text"
+          autoComplete="off"
+          value={form.cost}
+          onChange={update("cost")}
+        />
+      </label>
+
+      <label style={label}>
+        Descripción / Description *
+        <textarea
+          style={{ ...field, minHeight: "6rem", resize: "vertical" }}
+          name="description"
+          required
+          value={form.description}
+          onChange={update("description")}
+        />
+      </label>
+
+      <label style={label}>
+        Tu correo o teléfono / Your email or phone *
+        <span style={hint}> Solo para dudas sobre tu propuesta. / Only for questions about your suggestion.</span>
+        <input
+          style={field}
+          name="contact"
+          type="text"
+          required
+          autoComplete="off"
+          value={form.contact}
+          onChange={update("contact")}
+        />
+      </label>
+
+      {FORM_ENDPOINT ? (
+        <button type="submit" style={submitButton} disabled={submitting}>
+          {submitting ? "Enviando… / Sending…" : "Enviar propuesta / Submit suggestion"}
+        </button>
+      ) : (
+        <div style={notice} role="status">
+          <p style={{ margin: 0 }}>
+            El formulario en línea no está configurado por el momento. / The online form is not set up
+            at the moment.
+          </p>
+          <p style={{ margin: "0.4rem 0 0" }}>
+            <a href={mailto}>Envía tu evento por correo / Send your event by email</a>
+          </p>
+        </div>
+      )}
+
+      {failed && (
+        <p style={{ ...notice, borderColor: "var(--terracotta)" }} role="alert">
+          No se pudo enviar la propuesta. Inténtalo de nuevo, o{" "}
+          <a href={mailto}>envíala por correo / send it by email</a>.
+        </p>
+      )}
+    </form>
+  );
+}
diff --git a/test/events.test.mjs b/test/events.test.mjs
new file mode 100644
index 0000000..37dbcd6
--- /dev/null
+++ b/test/events.test.mjs
@@ -0,0 +1,234 @@
+import assert from "node:assert/strict";
+import { readFileSync, readdirSync } from "node:fs";
+import { join, sep } from "node:path";
+import test from "node:test";
+import events from "../app/events.mjs";
+import { UI_TEXT } from "../app/i18n.mjs";
+import {
+  eventJsonLd,
+  eventMarkerPosition,
+  eventStartMs,
+  eventVenueView,
+  formatEventRange,
+  isUpcomingEvent,
+  parseCancunDateTime,
+  upcomingEvents,
+} from "../app/event-utils.mjs";
+import { CATEGORIES } from "../app/place-index.mjs";
+
+const read = (path) => readFileSync(new URL(path, import.meta.url), "utf8");
+const readApp = (root, relative) => readFileSync(join(root, relative), "utf8");
+const places = JSON.parse(read("../public/data/places-index.json"));
+const placesById = new Map(places.map((place) => [place.id, place]));
+
+function collectSources(dir, root, acc = []) {
+  for (const entry of readdirSync(join(root, dir), { withFileTypes: true })) {
+    const relative = join(dir, entry.name);
+    if (entry.isDirectory()) {
+      if (entry.name === "node_modules" || entry.name.startsWith(".")) continue;
+      collectSources(relative, root, acc);
+    } else if (/\.(js|mjs)$/.test(entry.name)) {
+      acc.push(relative);
+    }
+  }
+  return acc;
+}
+
+test("events data validates: required bilingual fields, venue references, categories", () => {
+  const categoryIds = new Set(CATEGORIES.map(({ id }) => id));
+  const seen = new Set();
+  for (const event of events) {
+    assert.match(event.id, /^[a-z0-9][a-z0-9-]*$/, `${event.id}: id must be a safe slug`);
+    assert.ok(!seen.has(event.id), `${event.id}: duplicate id`);
+    seen.add(event.id);
+
+    for (const language of ["es", "en"]) {
+      assert.ok(
+        typeof event.title?.[language] === "string" && event.title[language].trim() !== "",
+        `${event.id}: title.${language} required`,
+      );
+      assert.ok(
+        typeof event.description?.[language] === "string" && event.description[language].trim() !== "",
+        `${event.id}: description.${language} required`,
+      );
+    }
+
+    assert.ok(eventStartMs(event) !== null, `${event.id}: startAt must parse`);
+    if (event.endAt) {
+      assert.ok(parseCancunDateTime(event.endAt) !== null, `${event.id}: endAt must parse`);
+      assert.ok(parseCancunDateTime(event.endAt) >= eventStartMs(event), `${event.id}: endAt must not precede startAt`);
+    }
+
+    assert.ok(event.venue && typeof event.venue === "object", `${event.id}: venue required`);
+    if (event.venue.placeId) {
+      assert.ok(placesById.has(event.venue.placeId), `${event.id}: venue.placeId must exist in the directory`);
+      assert.ok(event.venue.latitude === undefined, `${event.id}: coordinates belong on free-text venues`);
+    } else {
+      for (const language of ["es", "en"]) {
+        assert.ok(
+          typeof event.venue.name?.[language] === "string" && event.venue.name[language].trim() !== "",
+          `${event.id}: free-text venue needs name.${language}`,
+        );
+      }
+      if (event.venue.latitude !== undefined || event.venue.longitude !== undefined) {
+        assert.ok(
+          Number.isFinite(event.venue.latitude) && Number.isFinite(event.venue.longitude),
+          `${event.id}: venue coordinates must be finite numbers`,
+        );
+      }
+    }
+
+    assert.ok(categoryIds.has(event.category) && event.category !== "all", `${event.id}: category must be a directory category`);
+    if (event.cost) {
+      assert.ok(typeof event.cost.es === "string" && event.cost.es.trim() !== "", `${event.id}: cost.es`);
+    }
+  }
+});
+
+test("committed events are all still upcoming (no stale records in the data)", () => {
+  assert.ok(
+    upcomingEvents(events, Date.now()).length === events.length,
+    "an event in app/events.mjs has already ended; remove or extend it",
+  );
+});
+
+test("upcoming/past is decided at runtime on America/Cancun time (UTC-5, no DST)", () => {
+  // Offset-less endAt is read as Cancun wall time: 2026-10-11T23:59:59 in Cancun
+  // equals 2026-10-12T04:59:59Z. If it were read as UTC it would end hours earlier.
+  const event = { id: "x", startAt: "2026-10-10T20:00:00", endAt: "2026-10-11T23:59:59" };
+  assert.ok(isUpcomingEvent(event, Date.parse("2026-10-12T04:59:58Z")), "still open a second before close");
+  assert.ok(!isUpcomingEvent(event, Date.parse("2026-10-12T05:00:00Z")), "closed once Cancun passes midnight");
+
+  // A legacy whole-day end date means the END of that day in Cancun.
+  const legacy = { id: "y", startAt: "2026-10-01T00:00:00-05:00", dateEnd: "2026-10-11" };
+  assert.ok(isUpcomingEvent(legacy, Date.parse("2026-10-12T04:59:59Z")));
+  assert.ok(!isUpcomingEvent(legacy, Date.parse("2026-10-12T05:00:00Z")));
+
+  // Past events never appear, and sorting follows startAt regardless of input order.
+  const sorted = upcomingEvents(
+    [
+      { id: "later", startAt: "2026-11-01T10:00:00-05:00" },
+      { id: "past", startAt: "2025-01-01T09:00:00-05:00", endAt: "2025-01-01T12:00:00-05:00" },
+      { id: "sooner", startAt: "2026-10-20T10:00:00-05:00" },
+    ],
+    Date.parse("2026-10-11T12:00:00Z"),
+  );
+  assert.deepEqual(sorted.map((event) => event.id), ["sooner", "later"]);
+});
